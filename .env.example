# ---- required ----
DISCORD_TOKEN=your_discord_bot_token
ANTHROPIC_API_KEY=sk-ant-...

# Your server's ID. Slash commands register there instantly instead of waiting on
# Discord's global cache (which can take up to an hour). Enable Developer Mode in
# Discord settings, then right-click the server icon > Copy Server ID.
DEV_GUILD_ID=

# Only if you run the bot in MORE than one server. With DEV_GUILD_ID set, commands
# are registered to that one server and the global copies are withdrawn - otherwise
# each command would show up twice there. Set this to true to publish globally as
# well, and accept the up-to-an-hour delay in other servers.
SYNC_GLOBAL=false

# ---- model ----
# claude-sonnet-5 is the sweet spot. claude-haiku-4-5-20251001 is cheaper,
# claude-opus-5 is sharper but ~2.5x the price.
CLAUDE_MODEL=claude-sonnet-5
MAX_WEB_SEARCHES=5

# ---- behaviour ----
# auto = Portuguese if you asked in Portuguese or the post is Portuguese,
#        English for everything else. Or force: pt / en
REPLY_LANGUAGE=auto
BOT_NAME=Bot da Verdade

# Optional: user IDs auto-checked in EVERY channel, on top of /watch.
# Blunter than /watch, which is per-channel. /unwatch cannot remove these.
# Comma separated. Right-click a user in Discord > Copy User ID.
WATCH_USER_IDS=

# ---- media ----
# Look at the images in a post, and sample keyframes from its videos.
# Needs ffmpeg on PATH for video (brew install ffmpeg); without it the bot
# falls back to the video's thumbnail.
ANALYSE_MEDIA=true
# Hard cap on images sent to Claude per check. 0 disables media entirely.
MAX_IMAGES=4
# Frames sampled per video, evenly spaced.
VIDEO_FRAMES=3
MAX_VIDEO_MB=25
MAX_VIDEO_SECONDS=180

# ---- audio (speech in videos) ----
# auto   = use the OpenAI API if OPENAI_API_KEY is set, else local faster-whisper
#          if installed, else no audio at all.
# openai = OpenAI transcription API. Fast, ~0.3c/min, needs the key below.
# local  = faster-whisper on this machine. Free and private, slower.
#          Install with: pip install faster-whisper
# off    = never transcribe.
TRANSCRIBE_BACKEND=auto
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# tiny | base | small | medium | large-v3 - bigger is better and slower.
WHISPER_MODEL=base
MAX_TRANSCRIPT_CHARS=3000

# ---- cost guardrails ----
# The bot holds a pool of fact-check charges. EVERY check spends one: automatic
# links, @mentions, /factcheck and the right-click menu alike. Run out and it
# says so and goes quiet.
#
# The pool starts full every time the bot starts, and is not written to disk.
MAX_CHARGES=3
# When the pool is not full, one charge comes back this often.
CHARGE_REFILL_HOURS=8

# Minimum seconds between two AUTOMATIC checks of the same author. Does not apply
# when someone deliberately asks - they get an answer or a clear refusal.
COOLDOWN_SECONDS=30

HTTP_TIMEOUT=15
LOG_LEVEL=INFO
